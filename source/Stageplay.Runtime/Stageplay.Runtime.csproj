<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Description>Stageplay core runtime library.</Description>
        <Title>Stageplay Core Runtime</Title>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <PropertyGroup>
        <DocumentationFile>bin\$(Configuration)\net10.0\Stageplay.Runtime.xml</DocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <None Remove="Libraries\**\*" />

        <None Include="Libraries\win-x64\*.dll">
            <Pack>true</Pack>
            <PackagePath>runtimes/win-x64/native</PackagePath>
        </None>
        <None Include="Libraries\win-x86\*.dll">
            <Pack>true</Pack>
            <PackagePath>runtimes/win-x86/native</PackagePath>
        </None>
        <None Include="Libraries\win-arm64\*.dll">
            <Pack>true</Pack>
            <PackagePath>runtimes/win-arm64/native</PackagePath>
        </None>
        <None Include="Libraries\osx\*.dylib">
            <Pack>true</Pack>
            <PackagePath>runtimes/osx/native</PackagePath>
        </None>
        <None Include="Libraries\linux-x64\*.so">
            <Pack>true</Pack>
            <PackagePath>runtimes/linux-x64/native</PackagePath>
        </None>
        <None Include="Libraries\linux-arm64\*.so">
            <Pack>true</Pack>
            <PackagePath>runtimes/linux-arm64/native</PackagePath>
        </None>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" />
        <PackageReference Include="LuaCSharp" Version="0.5.6" />
        <PackageReference Include="MemoryPack" Version="1.21.4" />
        <PackageReference Include="ZString" Version="2.6.0" />
        <PackageReference Include="FosterFramework" Version="0.4.2" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Content/EmbeddedAssets/Fonts/**" Visible="false">
            <LogicalName>Fonts/%(Filename)%(Extension)</LogicalName>
        </EmbeddedResource>
    </ItemGroup>

</Project>

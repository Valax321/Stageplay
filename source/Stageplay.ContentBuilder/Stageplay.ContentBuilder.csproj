<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Title>Stageplay Content Builder</Title>
        <Description>APIs for converting game content into runtime formats. It's like MonoGame's new content builder, but framework-agnostic.</Description>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <RootNamespace>Radish.ContentBuilder</RootNamespace>
        <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    </PropertyGroup>

    <PropertyGroup>
        <DocumentationFile>bin\$(Configuration)\net10.0\Stageplay.ContentBuilder.xml</DocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Stageplay.Runtime\Stageplay.Runtime.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="CommandLineParser" Version="2.9.1" />
        <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" Version="10.0.12" />
        <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
        <PackageReference Include="System.IO.Hashing" Version="10.0.12" />
    </ItemGroup>

</Project>